{{!
    @template mod_tarsuszero/chat_card

    One exchange with the assistant: the learner's question on top, a thin
    divider, the assistant's answer below — a single centred card.

    Context variables required for this template:
    * question - string, the learner's question (escaped).
    * answer - string, server-cleaned HTML of the answer (output unescaped);
      empty while the answer is still being generated.
    * pending - bool, whether to show the thinking indicator instead of an answer.
    * useravatarurl - string, the learner's profile picture URL.
    * robotavatarurl - string, the assistant's avatar URL.
    * robotname - string, the assistant's display name.
}}
<div class="tarsus-card" data-region="tarsus-chat-card">
    <div class="tarsus-card__inner">
        <div class="tarsus-card__question d-flex align-items-start">
            <img class="tarsus-card__avatar" src="{{useravatarurl}}" alt="">
            <div class="tarsus-card__question-text">{{question}}</div>
        </div>
        <hr class="tarsus-card__divider">
        <div class="tarsus-card__answer d-flex align-items-start">
            <img class="tarsus-card__avatar" src="{{robotavatarurl}}" alt="{{robotname}}">
            <div class="tarsus-card__answer-body" data-region="card-answer">
                {{#pending}}
                    <span class="spinner-border spinner-border-sm text-muted" role="status" aria-hidden="true"></span>
                {{/pending}}
                {{^pending}}{{{answer}}}{{/pending}}
            </div>
        </div>
    </div>
</div>
