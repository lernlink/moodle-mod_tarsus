{{!
    @template mod_tarsuszero/teacher_dashboard

    Teacher reconciliation list: course material with per-bit brain status and
    per-resource index actions (index, re-index, remove, retry).

    Context variables required for this template:
    * cmid - int, the course module id (AJAX action target).
    * canmanage - bool, whether to show the inclusion toggle and index actions.
    * indexurl - string, URL that enqueues a full course index.
    * hasactivities - bool, whether any indexable materials exist.
    * hasmultiplepages - bool, whether the paging bar should be shown.
    * pagingbar - string, rendered Moodle paging bar (previous/next arrows).
    * resources - array of {
          name, modname, resourceid, title, type, url, hasurl, statuslabel,
          badgeclass, inflight, canindex, canreindex, canremove, canretry,
          caninclude, isincluded }.

    Example context (json):
    {
        "cmid": 2,
        "canmanage": true,
        "indexurl": "https://example.org/mod/tarsuszero/view.php?id=2&action=indexcourse&sesskey=abc",
        "hasactivities": true,
        "hasmultiplepages": false,
        "pagingbar": "",
        "resources": [
            {
                "name": "Cell biology",
                "modname": "page",
                "resourceid": "site:3:mod_page:2:main",
                "title": "Cell biology",
                "type": "text",
                "url": "https://example.org/mod/page/view.php?id=2",
                "hasurl": true,
                "statuslabel": "Indexed",
                "badgeclass": "badge-success",
                "inflight": false,
                "canindex": false,
                "canreindex": true,
                "canremove": true,
                "canretry": false,
                "caninclude": true,
                "isincluded": true
            }
        ]
    }
}}
<div class="mod-tarsuszero-dashboard" data-region="tarsus-dashboard" data-cmid="{{cmid}}">
    {{#canmanage}}
        <div class="mb-3">
            <a href="{{indexurl}}" class="btn btn-primary" role="button">
                {{#str}}indexcourse, mod_tarsuszero{{/str}}
            </a>
            <p class="text-muted mt-2">{{#str}}indexcourse_help, mod_tarsuszero{{/str}}</p>
        </div>
    {{/canmanage}}

    {{#hasactivities}}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">{{#str}}col_activity, mod_tarsuszero{{/str}}</th>
                    <th scope="col">{{#str}}col_type, mod_tarsuszero{{/str}}</th>
                    <th scope="col">{{#str}}col_status, mod_tarsuszero{{/str}}</th>
                    {{#canmanage}}
                        <th scope="col">{{#str}}col_included, mod_tarsuszero{{/str}}</th>
                        <th scope="col">{{#str}}col_actions, mod_tarsuszero{{/str}}</th>
                    {{/canmanage}}
                </tr>
            </thead>
            <tbody>
                {{#resources}}
                    <tr data-region="tarsus-resource" data-resourceid="{{resourceid}}">
                        <td>
                            {{#hasurl}}<a href="{{url}}">{{name}}</a>{{/hasurl}}
                            {{^hasurl}}{{name}}{{/hasurl}}
                        </td>
                        <td>{{type}}</td>
                        <td class="text-nowrap">
                            <span class="badge {{badgeclass}}" data-region="status-badge">{{statuslabel}}</span>
                            <span class="spinner-border spinner-border-sm text-muted ml-1" role="status"
                                  data-region="status-spinner" {{^inflight}}hidden{{/inflight}}>
                                <span class="sr-only">{{#str}}loading, core{{/str}}</span>
                            </span>
                        </td>
                        {{#canmanage}}
                            <td>
                                {{#caninclude}}
                                <div class="form-check form-switch mb-0" data-region="tarsus-include-cell">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           data-region="tarsus-include-toggle"
                                           aria-label="{{#str}}col_included, mod_tarsuszero{{/str}}"
                                           {{#isincluded}}checked{{/isincluded}}>
                                </div>
                                {{/caninclude}}
                            </td>
                            <td>
                                <div style="min-width:9rem">
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100"
                                            data-action="index" {{^canindex}}hidden{{/canindex}}>
                                        {{#str}}action_index, mod_tarsuszero{{/str}}
                                    </button>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill"
                                                data-action="reindex" {{^canreindex}}hidden{{/canreindex}}>
                                            {{#str}}action_reindex, mod_tarsuszero{{/str}}
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning flex-fill"
                                                data-action="retry" {{^canretry}}hidden{{/canretry}}>
                                            {{#str}}action_retry, mod_tarsuszero{{/str}}
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger flex-fill"
                                                data-action="remove" {{^canremove}}hidden{{/canremove}}>
                                            {{#str}}action_remove, mod_tarsuszero{{/str}}
                                        </button>
                                    </div>
                                </div>
                            </td>
                        {{/canmanage}}
                    </tr>
                {{/resources}}
            </tbody>
        </table>
        {{#hasmultiplepages}}
            {{{pagingbar}}}
        {{/hasmultiplepages}}
    {{/hasactivities}}

    {{^hasactivities}}
        <div class="alert alert-info">{{#str}}nomaterials, mod_tarsuszero{{/str}}</div>
    {{/hasactivities}}
</div>
{{#canmanage}}
    {{#js}}
        require(['mod_tarsuszero/dashboard'], function(Dashboard) {
            Dashboard.init({{cmid}}, '[data-region="tarsus-dashboard"]');
        });
    {{/js}}
{{/canmanage}}
