{{!
    @template mod_tarsuszero/teacher_dashboard

    Teacher reconciliation list: course material with per-bit brain status.

    Context variables required for this template:
    * canmanage - bool, whether to show the index action.
    * indexurl - string, URL that enqueues a full course index.
    * hasactivities - bool, whether any indexable activities exist.
    * activities - array of { name, modname, bits: [ { title, type, statuslabel, badgeclass } ] }.

    Example context (json):
    {
        "canmanage": true,
        "indexurl": "https://example.org/mod/tarsuszero/view.php?id=2&action=indexcourse&sesskey=abc",
        "hasactivities": true,
        "activities": [
            {
                "name": "Cell biology",
                "modname": "page",
                "bits": [
                    { "title": "Cell biology", "type": "text", "statuslabel": "Indexed", "badgeclass": "badge-success" }
                ]
            }
        ]
    }
}}
<div class="mod-tarsuszero-dashboard">
    {{#canmanage}}
        <div class="mb-3">
            <a href="{{indexurl}}" class="btn btn-primary" role="button">
                {{#str}}indexcourse, mod_tarsuszero{{/str}}
            </a>
            <p class="text-muted mt-2">{{#str}}indexcourse_help, mod_tarsuszero{{/str}}</p>
        </div>
    {{/canmanage}}

    {{#hasactivities}}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">{{#str}}col_activity, mod_tarsuszero{{/str}}</th>
                    <th scope="col">{{#str}}col_material, mod_tarsuszero{{/str}}</th>
                    <th scope="col">{{#str}}col_type, mod_tarsuszero{{/str}}</th>
                    <th scope="col">{{#str}}col_status, mod_tarsuszero{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#activities}}
                    {{#bits}}
                        <tr>
                            <td>{{name}}</td>
                            <td>{{title}}</td>
                            <td>{{type}}</td>
                            <td><span class="badge {{badgeclass}}">{{statuslabel}}</span></td>
                        </tr>
                    {{/bits}}
                {{/activities}}
            </tbody>
        </table>
    {{/hasactivities}}

    {{^hasactivities}}
        <div class="alert alert-info">{{#str}}nomaterials, mod_tarsuszero{{/str}}</div>
    {{/hasactivities}}
</div>
