{{!
    @template mod_tarsus/learn_motivation_card

    The brain's encouragement between two learning objectives: a
    blue-bordered card with the artwork, a title and the message.

    Context variables required for this template:
    * title - string, the brain's title; empty falls back to the plugin's own.
    * text - string, server-cleaned HTML of the message (output unescaped).
    Example context (json):
    {
        "title": "Keep going",
        "text": "<p>Two objectives done, one to go.</p>"
    }
}}
<div class="tarsus-card tarsus-card--welcome tarsus-learn-card--motivation" data-region="learn-motivation">
    <div class="tarsus-card__inner text-center">
        <div class="tarsus-welcome-art">{{#pix}}motivation, mod_tarsus{{/pix}}</div>
        <h3 class="tarsus-card__title">{{#title}}{{title}}{{/title}}{{^title}}{{#str}}learn_motivation_title, mod_tarsus{{/str}}{{/title}}</h3>
        <div class="tarsus-card__welcome-text">{{{text}}}</div>
    </div>
</div>
