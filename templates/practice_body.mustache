{{!
    @template mod_tarsus/practice_body

    The inside of a question card: question, answer inputs, Check button,
    score bar and feedback. Shared by the Test knowledge card and by a
    learning unit's check question (the meta sits on the card's band).

    Context variables required for this template: see mod_tarsus/practice_card.
    Example context (json):
    {
        "widgetid": "q-1",
        "widgettype": "singleChoiceQuestionWidget",
        "question": "<p>Which part of a transformer weighs the tokens against each other?</p>",
        "haschoices": true,
        "choices": [
            {
                "value": "Attention",
                "label": "Attention"
            },
            {
                "value": "Pooling",
                "label": "Pooling"
            }
        ],
        "hasvariables": false,
        "variables": [],
        "hastable": false,
        "table": [],
        "columns": [],
        "columnsjson": "[]",
        "taxonomy": "Understand",
        "difficulty": "Easy",
        "bars": [
            {
                "filled": true
            },
            {
                "filled": false
            },
            {
                "filled": false
            }
        ],
        "difficultyclass": "tarsus-practice-card__bars--grade-1",
        "hasbars": true,
        "state": "practice",
        "learn": false,
        "askenabled": true
    }
}}
    <div class="tarsus-practice-card__inner">
    <div class="tarsus-practice-card__question">{{{question}}}</div>
    {{#haschoices}}
    <div class="tarsus-practice-card__choices" data-region="choices" role="radiogroup">
        {{#choices}}
        <label class="tarsus-practice-choice" data-value="{{value}}">
            <input type="radio" class="tarsus-practice-choice__input" name="practice-{{widgetid}}" value="{{value}}">
            <span class="tarsus-practice-choice__label">{{label}}</span>
            <span class="tarsus-practice-choice__clarification d-none" data-region="clarification"></span>
        </label>
        {{/choices}}
    </div>
    {{/haschoices}}
    {{#hasvariables}}
    <div class="tarsus-practice-card__variables" data-region="variables">
        {{#variables}}
        <label class="tarsus-practice-variable">
            <span class="tarsus-practice-variable__name">{{name}}</span>
            <input type="text" class="tarsus-practice-variable__input form-control" data-variable="{{name}}"
                   placeholder="{{#str}}practice_variable_placeholder, mod_tarsus{{/str}}" autocomplete="off">
        </label>
        {{/variables}}
    </div>
    {{/hasvariables}}
    {{#hastable}}
    <div class="tarsus-practice-card__table-wrap">
    <table class="tarsus-practice-table" data-region="table">
        <thead>
            <tr>
                {{#columns}}<th scope="col">{{.}}</th>{{/columns}}
            </tr>
        </thead>
        <tbody>
            {{#table}}
            <tr class="tarsus-practice-table__row">
                {{#cells}}
                <td class="tarsus-practice-table__cell">
                    {{#ask}}<input type="text" class="tarsus-practice-table__input form-control form-control-sm" aria-label="{{label}}" autocomplete="off">{{/ask}}
                    {{^ask}}<span class="tarsus-practice-table__value">{{value}}</span>{{/ask}}
                </td>
                {{/cells}}
            </tr>
            {{/table}}
        </tbody>
    </table>
    </div>
    {{/hastable}}
    {{^haschoices}}{{^hasvariables}}{{^hastable}}
    <textarea class="tarsus-practice-card__input form-control" rows="3"
              placeholder="{{#str}}practice_answer_placeholder, mod_tarsus{{/str}}"
              aria-label="{{#str}}practice_answer_placeholder, mod_tarsus{{/str}}"></textarea>
    {{/hastable}}{{/hasvariables}}{{/haschoices}}
    <div class="tarsus-practice-card__actions">
        <button type="button" class="tarsus-practice-check btn btn-primary">
            <span class="tarsus-practice-check__spinner spinner-border spinner-border-sm d-none"
                  role="status" aria-hidden="true"></span>
            {{#str}}practice_check, mod_tarsus{{/str}}
        </button>
    </div>
    <div class="tarsus-practice-card__score d-none" data-region="score" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
         aria-label="{{#str}}practice_score, mod_tarsus{{/str}}">
        <div class="tarsus-practice-card__score-track"><div class="tarsus-practice-card__score-fill" data-region="score-fill"></div></div>
        <span class="tarsus-practice-card__score-value" data-region="score-value"></span>
    </div>
    <div class="tarsus-practice-card__feedback d-none" data-region="feedback"></div>
    </div>
