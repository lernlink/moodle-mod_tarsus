{{!
    @template mod_tarsus/practice_card

    One practice question card in the Test knowledge mode.

    Context variables required for this template:
    * widgetid - string, the question widget id.
    * widgettype - string, the question widget type.
    * question - string, the rendered question HTML (server-cleaned).
    * haschoices - bool, whether the question offers answer choices.
    * choices - array of {value, label} answer choices.
    * hasvariables - bool, whether the question asks for named quantities (rule of three).
    * variables - array of {name} quantities to answer, one input each.
    * hastable - bool, whether the question is a table question.
    * columns - array of the table's column names, as the brain sent them.
    * table - array of {cells: [{value, ask, label}]} rows; asked cells become inputs.
    * columnsjson - string, JSON list of the table's column names (sent back with the answer).
    * taxonomy - string, display label of the taxonomy level (may be empty).
    * difficulty - string, display label of the difficulty grade (may be empty).
    * bars - array of {filled} flags, one per difficulty bar (empty when unknown).
    * difficultyclass - string, modifier class colouring the filled bars by grade.
    * hasbars - bool, whether the difficulty bars render.
    * state - string, optional: 'learn' for a learning unit's check question (evaluated for learning
      units), 'practice' otherwise.
    * learn - bool, optional: frame the card like a learning unit.
    * askenabled - bool, whether the chat mode is on (shows "Ask about this").
    Example context (json):
    {
        "widgetid": "q-1",
        "widgettype": "singleChoiceQuestionWidget",
        "question": "<p>Which part of a transformer weighs the tokens against each other?</p>",
        "haschoices": true,
        "choices": [
            {
                "value": "Attention",
                "label": "Attention"
            },
            {
                "value": "Pooling",
                "label": "Pooling"
            }
        ],
        "hasvariables": false,
        "variables": [],
        "hastable": false,
        "table": [],
        "columns": [],
        "columnsjson": "[]",
        "taxonomy": "Understand",
        "difficulty": "Easy",
        "bars": [
            {
                "filled": true
            },
            {
                "filled": false
            },
            {
                "filled": false
            }
        ],
        "difficultyclass": "tarsus-practice-card__bars--grade-1",
        "hasbars": true,
        "state": "practice",
        "learn": false,
        "askenabled": true
    }
}}
<div class="tarsus-card tarsus-practice-card{{#learn}} tarsus-practice-card--learn{{/learn}}" data-region="practice-card"
     data-state="{{#state}}{{state}}{{/state}}{{^state}}practice{{/state}}"
     data-widget-id="{{widgetid}}" data-widget-type="{{widgettype}}"{{#hastable}} data-columns="{{columnsjson}}"{{/hastable}}>
    <div class="tarsus-card__band">
        {{#hasbars}}
        <span class="tarsus-difficulty {{difficultyclass}}" title="{{difficulty}}" role="img" aria-label="{{difficulty}}">
            {{#bars}}<span class="tarsus-difficulty__bar {{#filled}}tarsus-difficulty__bar--filled{{/filled}}"></span>{{/bars}}
        </span>
        {{/hasbars}}
        {{#taxonomy}}<span class="badge badge-light tarsus-practice-card__badge">{{taxonomy}}</span>{{/taxonomy}}
        {{#askenabled}}
        <button type="button" class="tarsus-learn-ask" data-action="ask-about"
                title="{{#str}}learn_ask_about, mod_tarsus{{/str}}">
            {{#pix}}reply, mod_tarsus{{/pix}}<span>{{#str}}learn_ask_about, mod_tarsus{{/str}}</span>
        </button>
        {{/askenabled}}
    </div>
    {{> mod_tarsus/practice_body }}
</div>
