{{!
    @template mod_tarsus/learn_stack_card

    One learning unit (stack of slides) in the Build knowledge mode.

    Context variables required for this template:
    * stackid - string, the stack id.
    * askenabled - bool, whether the chat mode is on (shows "Ask about this").
    * total - int, the number of slides, the check question included.
    * ringoffset - number, the ring's stroke offset for the first slide (see chat.js).
    * slides - array of {id, index, number, first, isquestion, taxonomy, taxonomyicon, title, text, image,
      imageposition, question (practice_card context, question slides only; its difficulty shows on the
      band after the ring while the slide is on)}; the slide's taxonomy
      level shows as the card badge (text only), falling back to the mode name.
    Example context (json):
    {
        "stackid": "stack-1",
        "askenabled": true,
        "total": 2,
        "ringoffset": "28.27",
        "slides": [
            {
                "id": "slide-1",
                "index": 0,
                "number": 1,
                "first": true,
                "isquestion": false,
                "taxonomy": "Understand",
                "taxonomyicon": "",
                "title": "Self-attention",
                "text": "<p>Every token looks at every other token.</p>",
                "image": "https://example.org/pluginfile.php/1/local_tarsus/slide/0/attention.png",
                "imageposition": "right"
            },
            {
                "id": "slide-q",
                "index": 1,
                "number": 2,
                "first": false,
                "isquestion": true,
                "taxonomy": "",
                "taxonomyicon": "",
                "title": "",
                "text": "",
                "image": "",
                "imageposition": "right",
                "question": {
                    "widgetid": "q-2",
                    "widgettype": "singleChoiceQuestionWidget",
                    "question": "<p>Which part of a transformer weighs the tokens against each other?</p>",
                    "haschoices": true,
                    "choices": [
                        {
                            "value": "Attention",
                            "label": "Attention"
                        },
                        {
                            "value": "Pooling",
                            "label": "Pooling"
                        }
                    ],
                    "hasvariables": false,
                    "variables": [],
                    "hastable": false,
                    "table": [],
                    "columnsjson": "[]",
                    "taxonomy": "Understand",
                    "difficulty": "Easy",
                    "bars": [
                        {
                            "filled": true
                        },
                        {
                            "filled": false
                        },
                        {
                            "filled": false
                        }
                    ],
                    "difficultyclass": "tarsus-practice-card__bars--grade-1",
                    "hasbars": true,
                    "state": "learn",
                    "learn": true,
                    "askenabled": true
                }
            }
        ]
    }
}}
<div class="tarsus-card tarsus-learn-card" data-region="learn-card" data-stack-id="{{stackid}}" data-total="{{total}}">
    <div class="tarsus-card__band tarsus-learn-card__meta">
        <svg class="tarsus-learn-ring" data-region="ring" viewBox="0 0 24 24" width="24" height="24" role="img" aria-live="polite"
             aria-label="{{#str}}learn_slide_of, mod_tarsus, { "current": 1, "total": {{total}} }{{/str}}">
            <circle class="tarsus-learn-ring__track" cx="12" cy="12" r="9"></circle>
            <circle class="tarsus-learn-ring__fill" cx="12" cy="12" r="9" style="stroke-dashoffset: {{ringoffset}}"></circle>
        </svg>
        {{#slides}}{{#isquestion}}{{#question}}{{#hasbars}}
        <span class="tarsus-difficulty {{difficultyclass}}{{^first}} d-none{{/first}}" data-region="slide-badge" data-index="{{index}}"
              title="{{difficulty}}" role="img" aria-label="{{difficulty}}">
            {{#bars}}<span class="tarsus-difficulty__bar {{#filled}}tarsus-difficulty__bar--filled{{/filled}}"></span>{{/bars}}
        </span>
        {{/hasbars}}{{/question}}{{/isquestion}}{{/slides}}
        <span class="tarsus-learn-player" data-region="audio-player" data-state="idle">
            <button type="button" class="tarsus-learn-player__toggle" data-action="audio-toggle"
                    title="{{#str}}learn_audio, mod_tarsus{{/str}}" aria-label="{{#str}}learn_audio, mod_tarsus{{/str}}">
                <span data-region="audio-speaker">{{#pix}}audio, mod_tarsus{{/pix}}</span>
                <span data-region="audio-play" class="d-none">{{#pix}}audio_play, mod_tarsus{{/pix}}</span>
                <span data-region="audio-pause" class="d-none">{{#pix}}audio_pause, mod_tarsus{{/pix}}</span>
            </button>
            <span class="tarsus-learn-player__wave d-none" data-region="audio-wave" aria-hidden="true"></span>
            <audio data-region="audio" preload="auto"></audio>
        </span>
        {{#slides}}
        <span class="badge badge-light tarsus-practice-card__badge tarsus-learn-badge{{^first}} d-none{{/first}}" data-region="slide-badge" data-index="{{index}}">
            {{#taxonomy}}{{taxonomy}}{{/taxonomy}}
            {{^taxonomy}}{{#str}}mode_build, mod_tarsus{{/str}}{{/taxonomy}}
        </span>
        {{/slides}}
        {{#askenabled}}
        <button type="button" class="tarsus-learn-ask" data-action="ask-about"
                title="{{#str}}learn_ask_about, mod_tarsus{{/str}}">
            {{#pix}}reply, mod_tarsus{{/pix}}<span>{{#str}}learn_ask_about, mod_tarsus{{/str}}</span>
        </button>
        {{/askenabled}}
    </div>
    <div class="tarsus-learn-card__inner">
        {{#slides}}
        <div class="tarsus-learn-slide{{^first}} d-none{{/first}}" data-region="slide" data-index="{{index}}"
             data-slide-id="{{id}}" data-slide-title="{{title}}">
            {{#isquestion}}{{#question}}
            <div class="tarsus-practice-card tarsus-practice-card--inslide" data-region="practice-card" data-state="learn"
                 data-widget-id="{{widgetid}}" data-widget-type="{{widgettype}}"{{#hastable}} data-columns="{{columnsjson}}"{{/hastable}}>
                {{> mod_tarsus/practice_body }}
            </div>
            {{/question}}{{/isquestion}}
            {{^isquestion}}
            {{#title}}<h5 class="tarsus-learn-slide__title">{{title}}</h5>{{/title}}
            <div class="tarsus-learn-slide__body tarsus-learn-slide__body--{{imageposition}}">
                {{#image}}<img class="tarsus-learn-slide__image" src="{{image}}" alt="" tabindex="0" role="button"
                     data-action="enlarge" title="{{#str}}learn_image_enlarge, mod_tarsus{{/str}}"
                     aria-label="{{#str}}learn_image_enlarge, mod_tarsus{{/str}}">{{/image}}
                <div class="tarsus-learn-slide__text">{{{text}}}</div>
            </div>
            {{/isquestion}}
        </div>
        {{/slides}}
        <div class="tarsus-learn-card__nav">
            <button type="button" class="btn btn-outline-secondary btn-sm tarsus-learn-nav" data-dir="-1" disabled>
                {{#str}}learn_previous, mod_tarsus{{/str}}
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm tarsus-learn-nav" data-dir="1"{{#single}} disabled{{/single}}>
                {{#str}}learn_next, mod_tarsus{{/str}}
            </button>
        </div>
    </div>
</div>
