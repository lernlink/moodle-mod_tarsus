{{!
    @template mod_tarsuszero/learner_chat

    Learner RAG Q&A grounded chat panel.

    Context variables required for this template:
    * cmid - int, the course module id.
    * containerid - string, a unique CSS class or ID for JS targeting.
    * useravatarurl - string, the learner's profile picture URL.
    * robotavatarurl - string, the assistant's avatar URL.
    * robotname - string, the assistant's display name.
}}
<div class="tarsus-chat-box flex-grow-1" id="{{containerid}}"
     data-user-avatar="{{useravatarurl}}"
     data-robot-avatar="{{robotavatarurl}}"
     data-robot-name="{{robotname}}">
    <!-- Practice progress: a fill bar across the top of the chat, hidden until the brain reports figures -->
    <div class="tarsus-progress d-none" data-region="progress" role="progressbar"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
         aria-label="{{#str}}practice_progress, mod_tarsuszero{{/str}}" title="">
        <div class="tarsus-progress__fill" data-region="progress-fill"></div>
    </div>
    <!-- Chat log flow -->
    <div class="tarsus-chat-flow p-3 border mb-3 flex-grow-1 bg-white" style="overflow-y: auto; border-radius: 8px;">
        <!-- Older-page loading indicator, shown while the feed lazy-loads on scroll-up -->
        <div class="tarsus-feed-older text-center py-2 text-muted d-none" data-region="feed-older">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        </div>
        <!-- Loading state helper or spinner -->
        <div class="text-center py-5 text-muted">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span class="ml-2">{{#str}}loading_history, mod_tarsuszero{{/str}}</span>
        </div>
    </div>

    <!-- Alert details -->
    <div class="tarsus-chat-alert alert alert-danger d-none mb-3" role="alert"></div>

    <!-- Composer: the question input above, the mode switcher and the send
         button in one row beneath, as in the Tarsus interface. The other
         modes work without the input, so it hides outside 'ask'. -->
    <form class="tarsus-chat-form card p-2 bg-light" method="post" action="view.php">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="text" class="tarsus-chat-input form-control mb-2" placeholder="{{#str}}chat_placeholder, mod_tarsuszero{{/str}}" aria-label="{{#str}}chat_placeholder, mod_tarsuszero{{/str}}" autocomplete="off" required>
        <div class="d-flex align-items-center justify-content-between" style="gap: 0.5rem;">
            <div class="d-flex align-items-center" style="gap: 0.75rem;">
            <div class="tarsus-mode-switch__group" role="group" aria-label="{{#str}}mode_switch, mod_tarsuszero{{/str}}">
                <button type="button" class="tarsus-mode-switch__btn" data-mode="build" aria-pressed="false">
                    {{#pix}}mode_build, mod_tarsuszero{{/pix}}{{#str}}mode_build, mod_tarsuszero{{/str}}
                </button>
                <button type="button" class="tarsus-mode-switch__btn" data-mode="test" aria-pressed="false">
                    {{#pix}}mode_test, mod_tarsuszero{{/pix}}{{#str}}mode_test, mod_tarsuszero{{/str}}
                </button>
                <button type="button" class="tarsus-mode-switch__btn tarsus-mode-switch__btn--active" data-mode="ask" aria-pressed="true">
                    {{#pix}}mode_ask, mod_tarsuszero{{/pix}}{{#str}}mode_ask, mod_tarsuszero{{/str}}
                </button>
            </div>
            <!-- Experience figures: appear once the practice mode reports them -->
            <span class="tarsus-xp-badge d-none" data-region="xp-badge"><span data-region="xp-earned">0</span>&nbsp;/&nbsp;<span data-region="xp-total">0</span>&nbsp;{{#str}}xp, mod_tarsuszero{{/str}}</span>
            </div>
            <span class="tarsus-mode-comingsoon text-muted small d-none">{{#str}}mode_comingsoon, mod_tarsuszero{{/str}}</span>
            <button class="tarsus-practice-next btn btn-primary d-flex align-items-center flex-shrink-0 d-none" type="button">
                <span class="tarsus-practice-next__spinner spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                <span data-region="practice-label">{{#str}}practice_start, mod_tarsuszero{{/str}}</span>
                {{#pix}}send, mod_tarsuszero{{/pix}}
            </button>
            <button class="tarsus-chat-submit btn btn-primary d-flex align-items-center flex-shrink-0" type="submit">
                <span class="tarsus-chat-spinner spinner-border spinner-border-sm mr-2 d-none" role="status" aria-hidden="true"></span>
                {{#str}}send, mod_tarsuszero{{/str}}{{#pix}}send, mod_tarsuszero{{/pix}}
            </button>
        </div>
    </form>
</div>

{{#js}}
require(['mod_tarsuszero/chat'], function(Chat) {
    Chat.init("{{cmid}}", "#{{containerid}}");
});
{{/js}}