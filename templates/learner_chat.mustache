{{!
    @template mod_tarsuszero/learner_chat

    Learner RAG Q&A grounded chat panel.

    Context variables required for this template:
    * cmid - int, the course module id.
    * containerid - string, a unique CSS class or ID for JS targeting.
}}
<div class="tarsus-chat-box flex-grow-1" id="{{containerid}}">
    <!-- Chat log flow -->
    <div class="tarsus-chat-flow p-3 border mb-3 flex-grow-1 bg-white" style="height: 400px; overflow-y: auto; border-radius: 8px;">
        <!-- Loading state helper or spinner -->
        <div class="text-center py-5 text-muted">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span class="ml-2">{{#str}}loading_history, mod_tarsuszero{{/str}}</span>
        </div>
    </div>

    <!-- Alert details -->
    <div class="tarsus-chat-alert alert alert-danger d-none mb-3" role="alert"></div>

    <!-- Subinput field -->
    <form class="tarsus-chat-form card p-2 bg-light" method="post" action="view.php">
        <input type="hidden" name="id" value="{{cmid}}">
        <div class="d-flex align-items-center" style="gap: 0.5rem;">
            <input type="text" class="tarsus-chat-input form-control" placeholder="{{#str}}chat_placeholder, mod_tarsuszero{{/str}}" aria-label="{{#str}}chat_placeholder, mod_tarsuszero{{/str}}" autocomplete="off" required>
            <button class="tarsus-chat-submit btn btn-primary d-flex align-items-center flex-shrink-0" type="submit">
                <span class="tarsus-chat-spinner spinner-border spinner-border-sm mr-2 d-none" role="status" aria-hidden="true"></span>
                {{#str}}send, mod_tarsuszero{{/str}}
            </button>
        </div>
    </form>
</div>

{{#js}}
require(['mod_tarsuszero/chat'], function(Chat) {
    Chat.init("{{cmid}}", "#{{containerid}}");
});
{{/js}}