{{!
    @template mod_tarsus/processing_card

    The "brain is working" indicator under the feed: a caption with a
    turning icon and a running bar. mod_tarsus/processing fills the
    caption and removes the card when the answer arrives.

    Context variables required for this template: none.
    Example context (json):
    {}
}}
<div class="tarsus-card tarsus-processing" data-region="processing" role="status" aria-live="polite">
    <div class="tarsus-processing__row">
        <span class="tarsus-processing__icon" data-region="icon"></span>
        <span class="tarsus-processing__text" data-region="text"></span>
    </div>
    <div class="tarsus-processing__bar"><div class="tarsus-processing__fill"></div></div>
</div>
