{{!
    @template mod_tarsuszero/learn_complete_card

    The brain's farewell once every learning objective is done: a
    green-bordered card with the artwork, a title and the message.

    Context variables required for this template:
    * text - string, server-cleaned HTML of the message (output unescaped).
}}
<div class="tarsus-card tarsus-card--welcome tarsus-learn-card--complete" data-region="learn-complete">
    <div class="tarsus-card__inner text-center">
        <div class="tarsus-welcome-art">{{#pix}}welcome, mod_tarsuszero{{/pix}}</div>
        <h5 class="tarsus-learn-slide__title">{{#str}}learn_complete_title, mod_tarsuszero{{/str}}</h5>
        <div class="tarsus-card__welcome-text">{{{text}}}</div>
    </div>
</div>
